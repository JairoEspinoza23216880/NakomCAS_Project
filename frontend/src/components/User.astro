---
// Este código se ejecuta solo en el cliente
if (typeof window !== 'undefined') {
  const token = localStorage.getItem('authToken');
  console.log('Auth Token:', token); // Ahora sí se imprimirá
  
  const isAuthenticated = () => {
    const token = localStorage.getItem('authToken');
    return !!token;
  };

  const getUserData = () => {
    const user = localStorage.getItem('user');
    return user ? JSON.parse(user) : null;
  };

  const authenticated = isAuthenticated();
  const userData = authenticated ? getUserData() : null;
}
---

<div id="user-menu-wrapper" data-authenticated={typeof window !== 'undefined' ? localStorage.getItem('authToken') ? 'true' : 'false' : 'false'}>
  {typeof window !== 'undefined' && localStorage.getItem('authToken') ? (
    <>
      <!-- Botón con avatar del usuario logueado -->
      <button id="user-menu-button" class="cursor-pointer items-center text-white rounded-xl">
        <img src="../../public/img/user.png" alt="imagen usuario" class="w-9 h-9 rounded-full mx-auto">
        <span class="text-sm text-gray-800 ml-2 hidden md:inline">
          {typeof window !== 'undefined' && localStorage.getItem('user') ? 
            JSON.parse(localStorage.getItem('user')).name || 'Usuario' : 
            'Usuario'}
        </span>
      </button>

      <!-- Menú para usuario logueado -->
      <div id="user-menu" class="hidden absolute right-0 mt-2 bg-white text-gray-700 rounded-xl shadow-lg border border-gray-200 z-10 min-w-48">
        <div class="px-4 py-2 border-b border-gray-100">
          <p class="font-semibold text-gray-800">
            {typeof window !== 'undefined' && localStorage.getItem('user') ? 
              JSON.parse(localStorage.getItem('user')).name || 'Usuario' : 
              'Usuario'}
          </p>
          <p class="text-sm text-gray-600">
            {typeof window !== 'undefined' && localStorage.getItem('user') ? 
              JSON.parse(localStorage.getItem('user')).email || '' : 
              ''}
          </p>
        </div>
        <a href="/Profile" class="block px-4 py-2 hover:bg-gray-100 border-b border-gray-100">Mi Perfil</a>
        <a href="/Dashboard" class="block px-4 py-2 hover:bg-gray-100 border-b border-gray-100">Mi Cuenta</a>
        <button 
          id="logout-btn"
          class="w-full text-left block px-4 py-2 hover:bg-gray-100 hover:rounded-b-xl text-red-600"
        >
          Cerrar sesión
        </button>
      </div>
    </>
  ) : (
    <>
      <!-- Botón para usuario no logueado -->
      <button id="user-menu-button" class="cursor-pointer items-center text-white rounded-xl">
        <img src="../../public/img/user.png" alt="imagen usuario" class="w-9 h-9 rounded-full mx-auto">
      </button>

      <!-- Menú para usuario no logueado -->
      <div id="user-menu" class="hidden absolute right-0 mt-2 bg-white text-gray-700 rounded-xl shadow-lg border border-gray-200 z-10">
        <a href="/Signup" class="block px-4 py-2 hover:bg-gray-100 hover:rounded-t-xl">Registrarse</a>
        <a href="/Login" class="block px-4 py-2 hover:bg-gray-100 hover:rounded-b-xl">Iniciar sesión</a>
      </div>
    </>
  )}
</div>  

<script>
  (function () {
    const btn = document.getElementById("user-menu-button");
    const menu = document.getElementById("user-menu");
    const wrapper = document.getElementById("user-menu-wrapper");
    const logoutBtn = document.getElementById("logout-btn");

    if (!btn || !menu || !wrapper) return;

    // Abrir/Cerrar menú
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      menu.classList.toggle("hidden");
    });

    // Manejar logout
    if (logoutBtn) {
      logoutBtn.addEventListener("click", () => {
        localStorage.removeItem('authToken');
        localStorage.removeItem('user');
        window.location.href = '/Login';
      });
    }

    // Cerrar menú al hacer clic fuera
    document.addEventListener("click", (e) => {
      const target = e.target;
      if (target && !wrapper.contains(target)) {
        menu.classList.add("hidden");
      }
    });
  })();
</script>