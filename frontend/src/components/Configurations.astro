---
const { selected = "" } = Astro.props;
---

<div class="w-full flex gap-6 p-6 min-h-screen max-w-6xl mx-auto">
  <!-- Sidebar -->
  <aside class="flex flex-col gap-6">
    <button
      class="p-4 rounded-xl border cursor-pointer hover:bg-gray-200"
      onclick="swapForm('basic')"
    >
      A
    </button>
    <button
      class="p-4 rounded-xl border cursor-pointer hover:bg-gray-200"
      onclick="swapForm('gaming')"
    >
      B
    </button>
    <button
      class="p-4 rounded-xl border cursor-pointer hover:bg-gray-200"
      onclick="swapForm('monitor')"
    >
      C
    </button>
    <button
      class="p-4 rounded-xl border cursor-pointer hover:bg-gray-200"
      onclick="swapForm('dev')"
    >
      D
    </button>
  </aside>

  <!-- Main Container -->
    <section class="flex-1 bg-white p-10 rounded-2xl shadow mx-10">
        <div id="form-area">
            <h2 class="text-4xl font-bold mb-6 text-center">Configuracion Basica</h2>
            <div class="flex flex-col gap-4">
                <label class="font-semibold">Color</label>
                <select class="w-2xl bg-gray-200 rounded-sm p-2 cursor-pointer">
                    <option value="Selecciona un color">Selecciona una opcion</option>
                    <option value="negro">Negro</option>
                    <option value="blanco">Blanco</option>
                </select>

                <label class="font-semibold">Almacenamiento</label>
                <select class="w-2xl bg-gray-200 rounded-sm p-2 cursor-pointer">
                    <option value="">Seleccione una opcion</option>
                    <option value=""></option>
                    <option value=""></option>
                </select>

                <label class="font-semibold">Tamanio</label>
                <select class="w-2xl bg-gray-200 rounded-sm p-2 cursor-pointer">
                    <option value="">Seleccione una opcion</option>
                    <option value=""></option>
                    <option value=""></option>
                </select>

                <label class="font-semibold">Conectividad</label>
                <select class="w-2xl bg-gray-200 rounded-sm p-2 cursor-pointer">
                    <option value="">Seleccione una opcion</option>
                    <option value=""></option>
                    <option value=""></option>
                </select>

                <label class="font-semibold">Perifericos</label>
                <select class="w-2xl bg-gray-200 rounded-sm p-2 cursor-pointer">
                    <option value="">Seleccione una opcion</option>
                    <option value=""></option>
                    <option value=""></option>
                </select>

                <label class="font-semibold">Comentario Adicional</label>
                <textarea class=" w-2xl bg-gray-200 h-32" placeholder="Escribe tu comentario"></textarea>
            </div>
        </div>
    </section>
</div>

<!-- SCRIPT FUNCIONAL -->
<script is:raw>
  const formsHTML = {
    basic: `
        <h2 class="text-4xl font-bold mb-6 text-center">Configuracion Basica</h2>
        <div class="flex flex-col gap-4">
            <label class="font-semibold">Color</label>
            <select class="w-2xl bg-gray-200 rounded-sm p-2 cursor-pointer">
                <option value="Selecciona un color">Selecciona una opcion</option>
                <option value="negro">Negro</option>
                <option value="blanco">Blanco</option>
            </select>

            <label class="font-semibold">Almacenamiento</label>
            <select class="w-2xl bg-gray-200 rounded-sm p-2 cursor-pointer">
                <option value="">Seleccione una opcion</option>
                <option value=""></option>
                <option value=""></option>
            </select>

            <label class="font-semibold">Tamanio</label>
            <select class="w-2xl bg-gray-200 rounded-sm p-2 cursor-pointer">
                <option value="">Seleccione una opcion</option>
                <option value=""></option>
                <option value=""></option>
            </select>

            <label class="font-semibold">Conectividad</label>
            <select class="w-2xl bg-gray-200 rounded-sm p-2 cursor-pointer">
                <option value="">Seleccione una opcion</option>
                <option value=""></option>
                <option value=""></option>
            </select>

            <label class="font-semibold">Perifericos</label>
            <select class="w-2xl bg-gray-200 rounded-sm p-2 cursor-pointer">
                <option value="">Seleccione una opcion</option>
                <option value=""></option>
                <option value=""></option>
            </select>

            <label class="font-semibold">Comentario Adicional</label>
            <textarea class=" w-2xl bg-gray-200 h-32" placeholder="Escribe tu comentario"></textarea>
        </div>
    `,

    gaming: `
      <h2 class='text-2xl font-bold mb-6 text-center text-orange-500 flex items-center gap-2'>
        🎮 Gaming
      </h2>
      <div class='grid grid-cols-2 gap-6'>
        <div>
          <h3 class='font-semibold mb-2'>Tipo de Juego</h3>
          <div class='flex flex-col gap-3'>
            <label class='flex items-center gap-2'><input type='checkbox'/> Emulación Retro</label>
            <label class='flex items-center gap-2'><input type='checkbox'/> Indies</label>
            <label class='flex items-center gap-2'><input type='checkbox'/> Emulación Moderna</label>
            <label class='flex items-center gap-2'><input type='checkbox'/> AAA</label>
          </div>
        </div>

        <div>
          <h3 class='font-semibold mb-2'>Resolución</h3>
          <div class='bg-gray-200 p-4 rounded-xl flex flex-col gap-4'>
            <div>
              <label class='block text-sm mb-1'>Resolución Esperada</label>
              <input class='w-full bg-gray-300 rounded p-2' />
            </div>
            <div>
              <label class='block text-sm mb-1'>FPS Deseados</label>
              <input class='w-full bg-gray-300 rounded p-2' />
            </div>
          </div>
          <p class='mt-4'>Mayor enfriamiento</p>
        </div>
      </div>

      <div class='mt-6'>
        <h3 class='font-semibold mb-2'>Juego Específico</h3>
        <textarea class='w-full bg-gray-200 rounded-xl p-4 h-32'></textarea>
      </div>
    `,

    monitor: `
      <h2 class='text-2xl font-bold mb-6 text-center text-green-500'>Monitor</h2>
      <p>Formulario Monitor aquí...</p>
    `,

    dev: `
      <h2 class='text-2xl font-bold mb-6 text-center text-purple-500'>Desarrollo</h2>
      <p>Formulario Dev aquí...</p>
    `,
  };

  function swapForm(name) {
    const element = document.getElementById("form-area");
    if (element && formsHTML[name]) {
      element.innerHTML = formsHTML[name];
    }
  }
</script>
