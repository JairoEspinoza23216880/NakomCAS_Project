  <!-- ALMACENAMIENTO -->
  <div>
    <label class="block text-sm font-medium text-gray-700">Almacenamiento</label
    >
    <select
      data-personalization
      class="mt-1 cursor-pointer block w-full pl-3 pr-10 py-2 text-base border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
      name="Almacenamiento"
      id="Almacenamiento"
    >
      <option value="" disabled selected class="text-gray-400"
        >Selecciona una opción</option
      >
      <option value="512GB" class="text-gray-900">512GB SSD</option>
      <option value="1TB" class="text-gray-900">1TB SSD</option>
      <option value="2TB" class="text-gray-900">2TB SSD</option>
    </select>
  </div>

  <!-- TAMAÑO -->
  <div>
    <label class="block text-sm font-medium text-gray-700"
      >Tamaño del Gabinete</label
    >
    <select
      data-personalization
      class="mt-1 cursor-pointer block w-full pl-3 pr-10 py-2 text-base border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
      name="tamanio"
      id="tamanio"
    >
      <option value="" disabled selected class="text-gray-400"
        >Selecciona una opción</option
      >
      <option value="Pequeño" class="text-gray-900">Pequeño (ITX)</option>
      <option value="Normal" class="text-gray-900">Normal (ATX)</option>
      <option value="Grande" class="text-gray-900">Grande (E-ATX)</option>
    </select>
  </div>

  <!-- COMENTARIO -->
  <div>
    <label class="block text-sm font-medium text-gray-700"
      >Comentario Adicional</label
    >
    <textarea
      class="w-full mt-1 bg-gray-100 rounded-lg p-3 h-32 resize-none focus:ring-2 focus:ring-gray-200"
      placeholder="Escribe tu comentario..."></textarea>
  </div>
</div>

