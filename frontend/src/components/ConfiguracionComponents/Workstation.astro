<h2 class="text-center text-3xl font-bold text-gray-800 mb-2">
    Configuración Workstation
</h2>
<p class="text-gray-600 mb-6 mt-5">
    Selecciona las opciones adecuadas para tus necesidades de trabajo
    profesional.
</p>
<div class="flex flex-col gap-6">
    <!-- Software -->
    <div>
        <label class="block text-sm font-medium text-gray-700"
            >Desarrollo de Software</label
        >
        <select
            data-need="Desarrollo de software"
            class="mt-1 cursor-pointer block w-full pl-3 pr-10 py-2 text-base border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
            name="Desarrollo de software"
            id="Desarrollo de software"
        >
            <option value="" disabled selected class="text-gray-400"
                >Selecciona una opción</option
            >
            <option value="Entusiasta" class="text-gray-900">Entusiasta</option>
            <option value="Emprendedor" class="text-gray-900"
                >Emprendedor</option
            >
            <option value="Profesional" class="text-gray-900"
                >Profesional</option
            >
        </select>
    </div>

    <!-- Datos -->
    <div>
        <label class="block text-sm font-medium text-gray-700"
            >Ciencia de Datos</label
        >
        <select
            data-need="Ciencia de datos"
