            data-need="Desarrollo videojuegos"
            class="mt-1 cursor-pointer block w-full pl-3 pr-10 py-2 text-base border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
            name="Desarrollo videojuegos"
            id="Desarrollo videojuegos"
        >
            <option value="" disabled selected class="text-gray-400"
                >Selecciona una opción</option
            >
            <option value="Entusiasta" class="text-gray-900">Entusiasta</option>
            <option value="Emprendedor" class="text-gray-900"
