            >
            <option value="Profesional" class="text-gray-900"
                >Profesional</option
            >
        </select>
    </div>

    <!-- Arquitectura e Ingenieria -->
    <div>
        <label class="block text-sm font-medium text-gray-700"
            >Arquitectura e Ingenieria</label
        >
        <select
            data-need="Arquitectura e Ingenieria"
            class="mt-1 cursor-pointer block w-full pl-3 pr-10 py-2 text-base border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
            name="Arquitectura e Ingenieria"
            id="Arquitectura e Ingenieria"
        >
            <option value="" disabled selected class="text-gray-400"
