            id="Ciencia de datos"
        >
            <option value="" disabled selected class="text-gray-400"
                >Selecciona una opción</option
            >
            <option value="Entusiasta" class="text-gray-900">Entusiasta</option>
            <option value="Emprendedor" class="text-gray-900"
