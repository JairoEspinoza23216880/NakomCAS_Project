---
const radioBase =
  "px-4 py-2 rounded-lg cursor-pointer transition-colors duration-200";
const radioIdle = "bg-gray-100 text-gray-700 hover:bg-gray-200";
const radioSelected = "bg-orange-500 text-white";
---

<div class="max-w-2xl mx-auto p-6 bg-white rounded-lg shadow-md">
  <h2 class="text-2xl font-semibold text-gray-800 mb-6">Accede a tu cuenta</h2>

  <div id="message-container"></div>

  <form id="login-form" class="space-y-6">
    <div>
      <label for="email" class="block mb-2 text-sm font-medium text-gray-600"
        >Correo Electrónico</label
      >
      <input
        type="email"
        id="email"
        name="email"
        placeholder="correo@ejemplo.com"
        class="w-full px-4 py-3 bg-gray-100 border-0 rounded-lg focus:ring-2 focus:ring-orange-500 focus:bg-white"
        required
      />
    </div>
    <div>
      <label for="password" class="block mb-2 text-sm font-medium text-gray-600"
        >Contraseña</label
      >
      <input
        type="password"
        id="password"
        name="password"
        placeholder="Contraseña"
        class="w-full px-4 py-3 bg-gray-100 border-0 rounded-lg focus:ring-2 focus:ring-orange-500 focus:bg-white"
        required
      />
    </div>
    <button
      type="submit"
      id="submit-btn"
      class="cursor-pointer w-full bg-orange-500 text-white px-4 py-3 rounded-lg font-semibold hover:bg-orange-600 transition-colors duration-200"
      >Iniciar Sesión</button
    >
  </form>

  <div class="mt-4">
    <label>
      ¿No tienes una cuenta?
      <a href="/Signup" class="text-orange-500 hover:underline"
        >Crear una cuenta</a
      >
    </label>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", async function () {
    const form = document.getElementById("login-form");
    const submitBtn = document.getElementById("submit-btn");
    const messageContainer = document.getElementById("message-container");

    form.addEventListener("submit", async function (e) {
      e.preventDefault();

      submitBtn.disabled = true;
      submitBtn.textContent = "Iniciando sesión...";
      messageContainer.innerHTML = "";

      try {
        const formData = new FormData(form);
        const credentials = {
          email: formData.get("email"),
          password: formData.get("password"),
        };

        // Validar email
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(credentials.email)) {
          throw new Error("Por favor, ingresa un correo electrónico válido");
        }

        // Importar y usar la función de login
        const { loginUser } = await import("../services/api.js");
        const result = await loginUser(credentials);

        if (result.success && result.token) {
          // Guardar token y datos de usuario en localStorage
          localStorage.setItem("authToken", result.token);
          localStorage.setItem("user", JSON.stringify(result.user));

          // Mostrar mensaje de éxito
          messageContainer.innerHTML = `
            <div class="mb-4 p-3 bg-green-100 text-green-700 rounded-lg">
              ¡Inicio de sesión exitoso!
            </div>
          `;

          // Redirigir después de 1 segundo
          setTimeout(() => {
            window.location.href = "/"; // Ajusta la ruta según tu estructura
          }, 1000);
        } else {
          throw new Error(result.message || "Error en el inicio de sesión");
        }
      } catch (error) {
        messageContainer.innerHTML = `
          <div class="mb-4 p-3 bg-red-100 text-red-700 rounded-lg">
            ${error.message || "Error en el inicio de sesión"}
          </div>
        `;
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = "Iniciar Sesión";
      }
    });
  });
</script>
