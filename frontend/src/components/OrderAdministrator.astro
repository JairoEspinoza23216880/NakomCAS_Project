---

---

<div class="p-6 bg-white rounded-lg shadow-md">
  <h2 class="text-2xl font-semibold mb-4">Administrar Pedidos</h2>

  <!-- Mensaje de carga/error -->
  <div id="mensaje-estado" class="mb-4 hidden">
    <p id="texto-estado" class="text-center py-4"></p>
  </div>

  <table class="w-full table-auto border-collapse">
    <thead>
      <tr class="bg-gray-200">
        <th
          class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
          >ID del Pedido</th
        >
        <th
          class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
          >Nombre del Cliente</th
        >
        <th
          class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
          >Fecha del pedido</th
        >
        <th
          class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
          >Estado Actual</th
        >
        <th
          class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"
          >Precio Total</th
        >
        <th
          class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"
          >Acciones</th
        >
      </tr>
    </thead>

    <tbody id="tabla-pedidos"></tbody>
  </table>
</div>

<!-- Modal de Detalles -->
<div
  id="modal"
  class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden"
>
  <div
    class="bg-white w-full max-w-3xl p-6 rounded-lg shadow-xl max-h-[90vh] overflow-y-auto"
  >
    <h3 class="text-xl font-semibold mb-4">
      Detalles del Pedido #<span id="m-id"></span>
    </h3>

    <!-- Información del Cliente -->
    <div class="mb-6 p-4 bg-gray-50 rounded">
      <h4 class="font-semibold mb-2">Información del Cliente</h4>
      <p><strong>Nombre:</strong> <span id="m-cliente"></span></p>
      <p><strong>Email:</strong> <span id="m-email"></span></p>
      <p><strong>Teléfono:</strong> <span id="m-phone"></span></p>
    </div>

    <!-- Información del Pedido -->
    <div class="mb-6 p-4 bg-gray-50 rounded">
      <h4 class="font-semibold mb-2">Información del Pedido</h4>
      <p><strong>Fecha:</strong> <span id="m-fecha"></span></p>
      <p><strong>Estado:</strong> <span id="m-estado"></span></p>
      <p><strong>Precio Total:</strong> <span id="m-total"></span></p>
    </div>

    <!-- Lista de Componentes -->
    <div class="mb-6">
      <h4 class="font-semibold mb-2">Componentes del Pedido</h4>
      <div id="m-componentes" class="space-y-2">
        <!-- Se llenará dinámicamente -->
      </div>
    </div>

    <button
      onclick="closeModal()"
      class="mt-4 bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600 w-full"
    >
      Cerrar
    </button>
  </div>
</div>

<script is:inline>
  // Estados permitidos según el contrato API
  const statusOptions = [
    "Pedido Recibido",
    "Esperando Pago",
    "Preparando Componentes",
    "En Ensamblaje",
    "Configuración y Pruebas",
    "Listo para Entrega",
    "Completado",
    "Cancelado",
  ];

  // Variable global para almacenar los pedidos
  let pedidos = [];

  // Obtener el token del localStorage
  function getToken() {
    return localStorage.getItem("authToken");
  }

  // Mostrar mensaje de estado
  function mostrarMensaje(texto, tipo = "info") {
    const mensajeDiv = document.getElementById("mensaje-estado");
    const textoP = document.getElementById("texto-estado");

    textoP.textContent = texto;
    mensajeDiv.classList.remove("hidden");

    if (tipo === "error") {
      textoP.className = "text-center py-4 text-red-600";
    } else if (tipo === "success") {
      textoP.className = "text-center py-4 text-green-600";
    } else {
      textoP.className = "text-center py-4 text-gray-600";
    }
  }

  function ocultarMensaje() {
    document.getElementById("mensaje-estado").classList.add("hidden");
  }

  // Cargar pedidos desde la API
  async function cargarPedidos() {
    const token = getToken();

    if (!token) {
      mostrarMensaje(
        "No se encontró token de autenticación. Por favor, inicia sesión.",
        "error",
      );
      return;
    }

    mostrarMensaje("Cargando pedidos...", "info");

    try {
      const response = await fetch("http://localhost:8000/api/admin/orders", {
        method: "GET",
        headers: {
          Authorization: `Bearer ${token}`,
          "Content-Type": "application/json",
        },
      });

      if (!response.ok) {
        if (response.status === 401) {
          throw new Error(
            "No autorizado. Por favor, inicia sesión nuevamente.",
          );
        }
        throw new Error(`Error al cargar pedidos: ${response.status}`);
      }

      const data = await response.json();
      pedidos = data.orders || []; // Extraer el array de orders
      ocultarMensaje();
      cargarTabla();
    } catch (error) {
      console.error("Error:", error);
      mostrarMensaje(error.message, "error");
    }
  }

  // Cargar tabla con los pedidos
  function cargarTabla() {
    const tbody = document.getElementById("tabla-pedidos");
    tbody.innerHTML = "";

    if (pedidos.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="6" class="text-center py-4 text-gray-500">
            No hay pedidos registrados
          </td>
        </tr>
      `;
      return;
    }

    pedidos.forEach((p) => {
      const fila = document.createElement("tr");
      fila.className = "hover:bg-gray-50";

      fila.innerHTML = `
        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${p.id}</td>
        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${p.client_name}</td>
        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${formatearFecha(p.date)}</td>

        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
          <select onchange="actualizarEstado(${p.id}, this.value)"
            class="border rounded px-2 py-1 text-sm">
            ${statusOptions
              .map(
                (s) =>
                  `<option value="${s}" ${s === p.status ? "selected" : ""}>${s}</option>`,
              )
              .join("")}
          </select>
        </td>

        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 text-right">$${Number(p.total_price || 0).toFixed(2)}</td>

        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
          <button onclick='verDetalles(${p.id})'
            class="bg-blue-500 text-white px-3 py-1 rounded-lg hover:bg-blue-600 text-sm">
            Ver Detalles
          </button>
        </td>
      `;

      tbody.appendChild(fila);
    });
  }

  // Formatear fecha
  function formatearFecha(fechaStr) {
    const fecha = new Date(fechaStr);
    return fecha.toLocaleString("es-MX", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit",
    });
  }

  // Ver detalles del pedido
  async function verDetalles(id) {
    const token = getToken();

    if (!token) {
      alert("No se encontró token de autenticación.");
      return;
    }

    try {
      const response = await fetch(
        `http://localhost:8000/api/admin/orders/${id}`,
        {
          method: "GET",
          headers: {
            Authorization: `Bearer ${token}`,
            "Content-Type": "application/json",
          },
        },
      );

      if (!response.ok) {
        const errorData = await response.json().catch(() => ({}));
        console.error("Error response:", errorData);
        throw new Error(
          `Error al cargar detalles: ${response.status} - ${errorData.message || ""}`,
        );
      }

      const data = await response.json();
      const pedido = data.order; // Extraer el objeto order
      mostrarModalDetalles(pedido);
    } catch (error) {
      console.error("Error:", error);
      alert("Error al cargar los detalles del pedido: " + error.message);
    }
  }

  // Mostrar modal con detalles
  function mostrarModalDetalles(pedido) {
    document.getElementById("m-id").textContent = pedido.id;
    document.getElementById("m-cliente").textContent =
      `${pedido.client_info.name} ${pedido.client_info.lastname}`;
    document.getElementById("m-email").textContent = pedido.client_info.email;
    document.getElementById("m-phone").textContent = pedido.client_info.phone;
    document.getElementById("m-fecha").textContent = formatearFecha(
      pedido.date,
    );
    document.getElementById("m-total").textContent =
      `$${Number(pedido.financials.total_price).toFixed(2)}`;
    document.getElementById("m-estado").textContent = pedido.status;

    // Cargar componentes
    const componentesDiv = document.getElementById("m-componentes");
    componentesDiv.innerHTML = "";

    if (pedido.components && pedido.components.length > 0) {
      const tabla = document.createElement("table");
      tabla.className = "w-full border-collapse border border-gray-300";
      tabla.innerHTML = `
        <thead>
          <tr class="bg-gray-100">
            <th class="border border-gray-300 px-4 py-2 text-left">Tipo</th>
            <th class="border border-gray-300 px-4 py-2 text-left">Nombre</th>
            <th class="border border-gray-300 px-4 py-2 text-center">Cantidad</th>
          </tr>
        </thead>
        <tbody>
          ${pedido.components
            .map(
              (comp) => `
            <tr>
              <td class="border border-gray-300 px-4 py-2">${comp.type_name || "N/A"}</td>
              <td class="border border-gray-300 px-4 py-2">${comp.name}</td>
              <td class="border border-gray-300 px-4 py-2 text-center">${comp.quantity}</td>
            </tr>
          `,
            )
            .join("")}
        </tbody>
      `;
      componentesDiv.appendChild(tabla);
    } else {
      componentesDiv.innerHTML =
        '<p class="text-gray-500">No hay componentes registrados</p>';
    }

    document.getElementById("modal").classList.remove("hidden");
  }

  // Cerrar modal
  function closeModal() {
    document.getElementById("modal").classList.add("hidden");
  }

  // Actualizar estado del pedido
  async function actualizarEstado(id, nuevoEstado) {
    const token = getToken();

    if (!token) {
      alert("No se encontró token de autenticación.");
      return;
    }

    try {
      const response = await fetch(
        `http://localhost:8000/api/admin/orders/${id}/status`,
        {
          method: "PATCH",
          headers: {
            Authorization: `Bearer ${token}`,
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ status: nuevoEstado }),
        },
      );

      if (!response.ok) {
        throw new Error(`Error al actualizar estado: ${response.status}`);
      }

      const resultado = await response.json();

      // Actualizar el estado local
      const pedido = pedidos.find((p) => p.id === id);
      if (pedido) {
        pedido.status = nuevoEstado;
      }

      mostrarMensaje(
        resultado.message || "Estado actualizado correctamente",
        "success",
      );
      setTimeout(() => ocultarMensaje(), 3000);
    } catch (error) {
      console.error("Error:", error);
      alert("Error al actualizar el estado: " + error.message);
      // Recargar la tabla para restaurar el estado anterior
      cargarPedidos();
    }
  }

  // Inicializar al cargar la página
  cargarPedidos();
</script>
