---

---

<!-- Página de administrador de Usuarios --><!-- Solo usuarios de tipo Vendedor deben entrar -->
<h2 class="text-3xl font-semibold mb-4 text-center mt-5">
  Administrar de Usuarios
</h2>
<div
  id="admin-usuarios"
  class="p-6 bg-white rounded-lg shadow-md max-w-[95%] mx-auto mt-8 mb-10"
>
  <!-- Mensaje de estado -->
  <div id="mensaje-estado" class="mb-4 hidden">
    <p id="texto-estado" class="text-center py-4"></p>
  </div>

  <table class="w-full table-auto border-collapse">
    <thead>
      <tr class="bg-gray-200">
        <th
          class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
          >ID</th
        >
        <th
          class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
          >Nombre</th
        >
        <th
          class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
          >Apellido</th
        >
        <th
          class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
          >Email</th
        >
        <th
          class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
          >Teléfono</th
        >
        <th
          class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
          >Rol</th
        >
        <th
          class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
          >Estado</th
        >
        <th
          class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
          >Fecha Registro</th
        >
        <th
          class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
          >Acciones</th
        >
      </tr>
    </thead>
    <tbody id="tabla-usuarios">
      <!-- Filas generadas dinámicamente -->
    </tbody>
  </table>

  <!-- Botón para crear nuevo usuario -->
  <div class="mt-6">
    <button
      id="btn-crear-usuario"
      class="cursor-pointer bg-green-500 text-white px-4 py-2 rounded-lg hover:bg-green-600 transition-colors duration-200"
    >
      Crear Nuevo Usuario
    </button>
  </div>

  <!-- Modal para crear/editar usuario -->
  <div
    id="usuario-modal"
    class="fixed inset-0 hidden items-center justify-center z-50"
  >
    <div class="absolute inset-0 bg-black opacity-50"></div>
    <div
      class="bg-white rounded-lg shadow-lg w-full max-w-lg mx-4 relative z-10"
    >
      <div class="p-4 border-b flex justify-between items-center">
        <h3 id="modal-title" class="text-lg font-semibold">Crear Usuario</h3>
        <button
          id="modal-close"
          class="cursor-pointer text-gray-500 hover:text-gray-700">✕</button
        >
      </div>
      <form id="usuario-form" class="p-4 space-y-3">
        <input type="hidden" name="id" />
        <div>
          <label class="block text-sm font-medium text-gray-700">Nombre *</label
          >
          <input
            name="name"
            class="mt-1 block w-full border rounded px-3 py-2"
            required
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700"
            >Apellido *</label
          >
          <input
            name="lastname"
            class="mt-1 block w-full border rounded px-3 py-2"
            required
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Email *</label>
          <input
            name="email"
            type="email"
            class="mt-1 block w-full border rounded px-3 py-2"
            required
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700"
            >Teléfono *</label
          >
          <input
            name="phone_number"
            class="mt-1 block w-full border rounded px-3 py-2"
            required
          />
        </div>
        <div id="password-row">
          <label class="block text-sm font-medium text-gray-700"
            >Contraseña <span id="password-hint" class="text-xs text-gray-500"
            ></span></label
          >
          <input
            name="password"
            type="password"
            class="mt-1 block w-full border rounded px-3 py-2"
            placeholder="Dejar en blanco para mantener la actual"
          />
        </div>
        <div class="flex justify-end gap-2">
          <button
            type="button"
            id="modal-cancel"
            class="cursor-pointer px-4 py-2 rounded border hover:bg-gray-100"
            >Cancelar</button
          >
          <button
            type="submit"
            id="modal-save"
            class="cursor-pointer px-4 py-2 rounded bg-blue-600 text-white hover:bg-blue-700"
            >Guardar</button
          >
        </div>
      </form>
    </div>
  </div>

  <script is:inline>
    // Variable global para almacenar usuarios
    let usuarios = [];

    // Obtener el token del localStorage
    function getToken() {
      return localStorage.getItem("authToken");
    }

    // Mostrar mensaje de estado
    function mostrarMensaje(texto, tipo = "info") {
      const mensajeDiv = document.getElementById("mensaje-estado");
      const textoP = document.getElementById("texto-estado");

      textoP.textContent = texto;
      mensajeDiv.classList.remove("hidden");

      if (tipo === "error") {
        textoP.className = "text-center py-4 text-red-600";
      } else if (tipo === "success") {
        textoP.className = "text-center py-4 text-green-600";
      } else {
        textoP.className = "text-center py-4 text-gray-600";
      }
    }

    function ocultarMensaje() {
      document.getElementById("mensaje-estado").classList.add("hidden");
    }

    // Cargar usuarios desde la API
    async function fetchUsuarios() {
      const token = getToken();

      if (!token) {
        mostrarMensaje(
          "No se encontró token de autenticación. Por favor, inicia sesión.",
          "error",
        );
        return;
      }

      mostrarMensaje("Cargando usuarios...", "info");

      try {
        const response = await fetch("http://localhost:8000/api/admin/users", {
          method: "GET",
          headers: {
            Authorization: `Bearer ${token}`,
            "Content-Type": "application/json",
          },
        });

        if (!response.ok) {
          if (response.status === 401) {
            throw new Error(
              "No autorizado. Por favor, inicia sesión nuevamente.",
            );
          }
          throw new Error(`Error al cargar usuarios: ${response.status}`);
        }

        usuarios = await response.json();
        ocultarMensaje();
        renderUsuarios();
      } catch (error) {
        console.error("Error:", error);
        mostrarMensaje(error.message, "error");
      }
    }

    // Renderizar tabla de usuarios
    function renderUsuarios() {
      const tbody = document.getElementById("tabla-usuarios");
      tbody.innerHTML = "";

      if (usuarios.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="9" class="py-4 text-center text-gray-500">
              No hay usuarios registrados
            </td>
          </tr>
        `;
        return;
      }

      usuarios.forEach((u) => {
        const fila = document.createElement("tr");
        fila.className = "hover:bg-gray-50";

        const estadoClass =
          u.status === "Activo" ? "text-green-600" : "text-red-600";
        const botonEstado =
          u.status === "Activo"
            ? `<button onclick="cambiarEstado(${u.id}, 'Inactivo')" class="cursor-pointer bg-orange-500 text-white px-3 py-1 rounded-lg hover:bg-orange-600 text-sm">Desactivar</button>`
            : `<button onclick="cambiarEstado(${u.id}, 'Activo')" class="cursor-pointer bg-green-500 text-white px-3 py-1 rounded-lg hover:bg-green-600 text-sm">Activar</button>`;

        fila.innerHTML = `
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${u.id}</td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${u.name}</td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${u.lastname}</td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${u.email}</td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${u.phone_number}</td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${u.role}</td>
          <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold ${estadoClass}">${u.status}</td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${formatearFecha(u.register_date)}</td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
            <button onclick="editarUsuario(${u.id})" class="cursor-pointer bg-blue-500 text-white px-3 py-1 rounded-lg hover:bg-blue-600 text-sm mr-2">Editar</button>
            ${botonEstado}
          </td>
        `;

        tbody.appendChild(fila);
      });
    }

    // Formatear fecha
    function formatearFecha(fechaStr) {
      if (!fechaStr) return "N/A";
      const fecha = new Date(fechaStr);
      return fecha.toLocaleDateString("es-MX");
    }

    // Abrir modal para crear usuario
    function crearUsuario() {
      const modal = document.getElementById("usuario-modal");
      const titleEl = document.getElementById("modal-title");
      const form = document.getElementById("usuario-form");
      const passwordRow = document.getElementById("password-row");
      const passwordInput = form.querySelector('[name="password"]');

      titleEl.textContent = "Crear Usuario";
      form.reset();
      form.querySelector('[name="id"]').value = "";

      // En modo crear, la contraseña es requerida
      passwordInput.required = true;
      passwordInput.placeholder = "";
      document.getElementById("password-hint").textContent = "*";

      modal.classList.remove("hidden");
      modal.classList.add("flex");
    }

    // Abrir modal para editar usuario
    function editarUsuario(id) {
      const usuario = usuarios.find((u) => u.id === id);
      if (!usuario) {
        alert("Usuario no encontrado");
        return;
      }

      const modal = document.getElementById("usuario-modal");
      const titleEl = document.getElementById("modal-title");
      const form = document.getElementById("usuario-form");
      const passwordInput = form.querySelector('[name="password"]');

      titleEl.textContent = "Editar Usuario";
      form.reset();

      form.querySelector('[name="id"]').value = usuario.id;
      form.querySelector('[name="name"]').value = usuario.name;
      form.querySelector('[name="lastname"]').value = usuario.lastname;
      form.querySelector('[name="email"]').value = usuario.email;
      form.querySelector('[name="phone_number"]').value = usuario.phone_number;

      // En modo editar, la contraseña es opcional
      passwordInput.required = false;
      passwordInput.placeholder = "Dejar en blanco para mantener la actual";
      document.getElementById("password-hint").textContent = "(opcional)";

      modal.classList.remove("hidden");
      modal.classList.add("flex");
    }

    // Cerrar modal
    function closeModal() {
      const modal = document.getElementById("usuario-modal");
      modal.classList.remove("flex");
      modal.classList.add("hidden");
    }

    // Cambiar estado del usuario (Activar/Desactivar)
    async function cambiarEstado(id, nuevoEstado) {
      const token = getToken();

      if (!token) {
        alert("No se encontró token de autenticación.");
        return;
      }

      const mensaje =
        nuevoEstado === "Inactivo"
          ? "¿Estás seguro de que quieres bloquear el acceso a este usuario?"
          : "¿Estás seguro de que quieres reactivar este usuario?";

      if (!confirm(mensaje)) return;

      try {
        const response = await fetch(
          `http://localhost:8000/api/admin/users/${id}/status`,
          {
            method: "PATCH",
            headers: {
              Authorization: `Bearer ${token}`,
              "Content-Type": "application/json",
            },
            body: JSON.stringify({ status: nuevoEstado }),
          },
        );

        if (!response.ok) {
          throw new Error(`Error al cambiar estado: ${response.status}`);
        }

        const resultado = await response.json();

        // Actualizar el estado local
        const usuario = usuarios.find((u) => u.id === id);
        if (usuario) {
          usuario.status = nuevoEstado;
        }

        renderUsuarios();
        mostrarMensaje(
          resultado.message || "Estado actualizado correctamente",
          "success",
        );
        setTimeout(() => ocultarMensaje(), 3000);
      } catch (error) {
        console.error("Error:", error);
        alert("Error al cambiar el estado: " + error.message);
      }
    }

    // Manejar submit del formulario
    document.addEventListener("DOMContentLoaded", () => {
      const form = document.getElementById("usuario-form");
      const btnClose = document.getElementById("modal-close");
      const btnCancel = document.getElementById("modal-cancel");
      const btnCrear = document.getElementById("btn-crear-usuario");

      if (btnCrear) {
        btnCrear.addEventListener("click", crearUsuario);
      }

      if (btnClose) {
        btnClose.addEventListener("click", (e) => {
          e.preventDefault();
          closeModal();
        });
      }

      if (btnCancel) {
        btnCancel.addEventListener("click", (e) => {
          e.preventDefault();
          closeModal();
        });
      }

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const token = getToken();

        if (!token) {
          alert("No se encontró token de autenticación.");
          return;
        }

        const formData = new FormData(form);
        const payload = {};

        // Construir payload según el contrato API
        const id = formData.get("id");
        payload.name = formData.get("name");
        payload.lastname = formData.get("lastname");
        payload.email = formData.get("email");
        payload.phone_number = formData.get("phone_number");

        // Solo incluir password si tiene valor
        const password = formData.get("password");
        if (password && password.trim() !== "") {
          payload.password = password;
        }

        try {
          const method = id ? "PUT" : "POST";
          const url = id
            ? `http://localhost:8000/api/admin/users/${id}`
            : "http://localhost:8000/api/admin/users";

          const response = await fetch(url, {
            method,
            headers: {
              Authorization: `Bearer ${token}`,
              "Content-Type": "application/json",
            },
            body: JSON.stringify(payload),
          });

          if (!response.ok) {
            const errorData = await response.json();
            throw new Error(errorData.message || `Error ${response.status}`);
          }

          const resultado = await response.json();

          closeModal();
          await fetchUsuarios();

          mostrarMensaje(
            resultado.message ||
              (id
                ? "Usuario actualizado correctamente"
                : "Usuario creado correctamente"),
            "success",
          );
          setTimeout(() => ocultarMensaje(), 3000);
        } catch (error) {
          console.error("Error:", error);
          alert("Error al guardar usuario: " + error.message);
        }
      });

      // Cargar usuarios al iniciar
      fetchUsuarios();
    });
  </script>
</div>
